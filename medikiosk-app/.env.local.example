# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Gemini API keys, split per feature so each has its own rate limit.
# Get keys at https://aistudio.google.com/apikey
# Each falls back to GEMINI_API_KEY, then GOOGLE_GENERATIVE_AI_API_KEY, if unset.
GEMINI_API_KEY_INTAKE=
GEMINI_API_KEY_DOCUMENTS=
GEMINI_API_KEY_SUMMARY=
GEMINI_API_KEY=

# Supabase project credentials (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
