# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Groq API keys, split per feature so each has its own rate limit.
# Get keys at https://console.groq.com/keys
# Each falls back to GROQ_API_KEY if unset.
GROQ_API_KEY_INTAKE=
GROQ_API_KEY_DOCUMENTS=
GROQ_API_KEY_SUMMARY=
GROQ_API_KEY=

# Supabase project credentials (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ABDM / ABHA (currently mocked — see src/lib/abdm/client.ts)
ABDM_BASE_URL=https://healthidsbx.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
